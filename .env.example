# AnnaSetu Environment Configuration
# Copy to .env and fill in your values

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite used if not set)
DATABASE_URL=sqlite:///db.sqlite3

# Redis (optional in dev - in-memory fallback used)
REDIS_URL=redis://localhost:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Twilio SMS (optional, behind ENABLE_SMS flag)
ENABLE_SMS=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI features (optional, off by default)
ENABLE_AI=False
ANTHROPIC_API_KEY=

# Site
SITE_URL=http://localhost:8000
SITE_NAME=AnnaSetu

# Matching
MATCHING_RADIUS_KM=25
MATCHING_TOP_N=5
AUTO_ACCEPT_RELIABILITY_THRESHOLD=4.5

# QR token expiry (seconds)
QR_TOKEN_MAX_AGE=86400
